{
  "schema": "aegisqda-synthetic-interview-corpus-v2",
  "suite_type": "red-expected de-identification acceptance suite",
  "purpose": "Exercise the AegisQDA gateway end to end on interview-shaped input and measure de-identification. This is an acceptance/measurement corpus, not a green happy-path: on any given host, expected identifiers may still leak (e.g. NER recall gaps), and the verifier reports exactly which. It is neither an anonymity claim nor a recall claim.",
  "synthetic_disclosure": "No real person and no real personal data. Contact identifiers are dummy values: e-mail/URL use RFC 2606 reserved domains (*.invalid, *.example); IP addresses are RFC 5737 TEST-NET; IBANs are structurally-valid LU patterns with invalid check digits; phone numbers are documentation-style +352 621 xxx xxx and are NOT verified as unassigned. Place names (Esch, Dudelange/Düdelingen) are real Luxembourg municipalities used only as a neutral geographic setting; they carry no linkage to any real individual. Names and organisations are invented.",
  "offsets": "Python str character indices over UTF-8 decoded text (as the detector reports).",
  "ner_note": "PERSON/ORGANIZATION/LOCATION are found by the installed spaCy models (de/fr/en) once detection.py normalises PER/LOC/ORG/GPE labels to the policy entity names. Values here are best-effort expectations for recall measurement; a miss is a reported residual-risk finding, not a verifier bug.",
  "expected_outcomes": {
    "clean": "no block-action findings; after confirm+transform, a second real scan finds zero residual identifiers. Any surviving expected value is a FAIL.",
    "block": "contains block-action indirect identifiers; release is fail-closed.",
    "safe": "zero findings from the real detector (over-redaction guard)."
  },
